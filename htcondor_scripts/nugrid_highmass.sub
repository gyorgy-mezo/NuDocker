################################################################################
# HTCondor Submit File: NuGrid Parameter Study - High Mass Stars (15-20 M☉)
#
# Models: 15-20 M☉ with varying metallicity and mixing length alpha
# Resources: 32 CPUs, 32 GB memory, 72 hours
################################################################################

universe                = docker
docker_image            = nugrid/nudome:16.0

+JobName                = "NuGrid_HighMass"

# Resource requirements
request_cpus            = 32
request_memory          = 32 GB
request_disk            = 15 GB
+MaxRuntime             = 259200  # 72 hours

# Execution
executable              = run_mesa_model.sh
arguments               = $(Process) $(mass) $(metallicity) $(alpha)
environment             = "OMP_NUM_THREADS=32 MESA_DIR=/home/user/mesa"

# File transfer
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = results_$(Process).tar.gz

# Logging
log                     = logs/highmass_$(Cluster).log
output                  = logs/highmass_$(Cluster)_$(Process).out
error                   = logs/highmass_$(Cluster)_$(Process).err

# Checkpointing
+WantCheckpoint         = True
+CheckpointPeriod       = 7200
max_retries             = 3

# Requirements
requirements            = (HasDocker =?= True)
rank                    = (KFlops * 1000) + Memory

# Job statistics
+AccountingGroup        = "astrophysics.stellar"
+Project                = "NuGrid_ParameterStudy"

# High-mass models: 15-20 M☉ × 3 metallicities × 3 alphas = 18 jobs

# 15.0 M☉ models
mass = 15.0
metallicity = 0.02
alpha = 1.8
queue

metallicity = 0.02
alpha = 2.0
queue

metallicity = 0.02
alpha = 2.2
queue

metallicity = 0.01
alpha = 1.8
queue

metallicity = 0.01
alpha = 2.0
queue

metallicity = 0.01
alpha = 2.2
queue

metallicity = 0.001
alpha = 1.8
queue

metallicity = 0.001
alpha = 2.0
queue

metallicity = 0.001
alpha = 2.2
queue

# 20.0 M☉ models
mass = 20.0
metallicity = 0.02
alpha = 1.8
queue

metallicity = 0.02
alpha = 2.0
queue

metallicity = 0.02
alpha = 2.2
queue

metallicity = 0.01
alpha = 1.8
queue

metallicity = 0.01
alpha = 2.0
queue

metallicity = 0.01
alpha = 2.2
queue

metallicity = 0.001
alpha = 1.8
queue

metallicity = 0.001
alpha = 2.0
queue

metallicity = 0.001
alpha = 2.2
queue
