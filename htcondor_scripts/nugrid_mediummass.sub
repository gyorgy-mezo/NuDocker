################################################################################
# HTCondor Submit File: NuGrid Parameter Study - Medium Mass Stars (5-10 M☉)
#
# Models: 5-10 M☉ with varying metallicity and mixing length alpha
# Resources: 16 CPUs, 16 GB memory, 24 hours
################################################################################

universe                = docker
docker_image            = nugrid/nudome:16.0

+JobName                = "NuGrid_MediumMass"

# Resource requirements
request_cpus            = 16
request_memory          = 16 GB
request_disk            = 10 GB
+MaxRuntime             = 86400  # 24 hours

# Execution
executable              = run_mesa_model.sh
arguments               = $(Process) $(mass) $(metallicity) $(alpha)
environment             = "OMP_NUM_THREADS=16 MESA_DIR=/home/user/mesa"

# File transfer
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = mesa_work_template.tar.gz, parameter_grid_mediummass.txt
transfer_output_files   = results_$(Process).tar.gz

# Logging
log                     = logs/mediummass_$(Cluster).log
output                  = logs/mediummass_$(Cluster)_$(Process).out
error                   = logs/mediummass_$(Cluster)_$(Process).err

# Checkpointing
+WantCheckpoint         = True
+CheckpointPeriod       = 7200
max_retries             = 3

# Requirements
requirements            = (HasDocker =?= True)
rank                    = (KFlops * 1000) + Memory

# Job statistics
+AccountingGroup        = "astrophysics.stellar"
+Project                = "NuGrid_ParameterStudy"

# Medium-mass models: 5-10 M☉ × 3 metallicities × 3 alphas = 18 jobs

# 5.0 M☉ models
mass = 5.0
metallicity = 0.02
alpha = 1.8
queue

metallicity = 0.02
alpha = 2.0
queue

metallicity = 0.02
alpha = 2.2
queue

metallicity = 0.01
alpha = 1.8
queue

metallicity = 0.01
alpha = 2.0
queue

metallicity = 0.01
alpha = 2.2
queue

metallicity = 0.001
alpha = 1.8
queue

metallicity = 0.001
alpha = 2.0
queue

metallicity = 0.001
alpha = 2.2
queue

# 10.0 M☉ models
mass = 10.0
metallicity = 0.02
alpha = 1.8
queue

metallicity = 0.02
alpha = 2.0
queue

metallicity = 0.02
alpha = 2.2
queue

metallicity = 0.01
alpha = 1.8
queue

metallicity = 0.01
alpha = 2.0
queue

metallicity = 0.01
alpha = 2.2
queue

metallicity = 0.001
alpha = 1.8
queue

metallicity = 0.001
alpha = 2.0
queue

metallicity = 0.001
alpha = 2.2
queue
