# HTCondor DAGMan Configuration for NuGrid Parameter Study

# Dagman log file
DAGMAN_LOG = nugrid_study.dagman.log

# Maximum number of times to retry the entire DAG
DAGMAN_MAX_JOBS_IDLE = 100
DAGMAN_MAX_JOBS_SUBMITTED = 200

# Submit delay (seconds between job submissions)
DAGMAN_SUBMIT_DELAY = 2

# Maximum pre-scripts to run simultaneously
DAGMAN_MAX_PRE_SCRIPTS = 10

# Maximum post-scripts to run simultaneously
DAGMAN_MAX_POST_SCRIPTS = 10

# Rescue DAG configuration
DAGMAN_MAX_RESCUE_NUM = 3

# Pending reporting interval (seconds)
DAGMAN_PENDING_REPORT_INTERVAL = 600

# Allow log error
DAGMAN_ALLOW_LOG_ERROR = True

# Suppress notification
DAGMAN_SUPPRESS_NOTIFICATION = False

# Priority adjustment
DAGMAN_USE_DIRECT_SUBMIT = True
