## HTCondor Central Manager Configuration
## Generated by Ansible

## Role configuration
use ROLE: CentralManager
use ROLE: Submit

## Network configuration
CONDOR_HOST = {{ condor_host }}
NETWORK_INTERFACE = *
BIND_ALL_INTERFACES = TRUE

## Collector configuration
COLLECTOR_NAME = $(CONDOR_HOST)
COLLECTOR_HOST = $(CONDOR_HOST):9618

## Negotiator configuration
NEGOTIATOR_INTERVAL = 20
NEGOTIATOR_CYCLE_DELAY = 5

## Schedd configuration (for job submission)
SCHEDD_NAME = {{ cluster_name }}-central
MAX_JOBS_RUNNING = 1000
MAX_JOBS_SUBMITTED = 10000

## Docker Universe support
DOCKER = /usr/bin/docker

## Security - Pool Password
SEC_PASSWORD_FILE = /etc/condor/pool_password
SEC_DEFAULT_AUTHENTICATION = REQUIRED
SEC_DEFAULT_AUTHENTICATION_METHODS = PASSWORD
SEC_READ_AUTHENTICATION = REQUIRED
SEC_WRITE_AUTHENTICATION = REQUIRED
SEC_CLIENT_AUTHENTICATION = REQUIRED
SEC_NEGOTIATOR_AUTHENTICATION = REQUIRED
SEC_ADVERTISE_STARTD_AUTHENTICATION = REQUIRED

## Authorization
ALLOW_READ = *
ALLOW_WRITE = condor@*, submit-side@*
ALLOW_NEGOTIATOR = condor@*
ALLOW_DAEMON = condor@*
ALLOW_ADMINISTRATOR = condor@$(CONDOR_HOST)

## High port range
HIGHPORT = 42000
LOWPORT = 41000

## Logging
MAX_DEFAULT_LOG = 100000000
MAX_NUM_DEFAULT_LOG = 5
TRUNC_DEFAULT_LOG_ON_OPEN = FALSE

## Daemon list (collector + negotiator + schedd + master)
DAEMON_LIST = COLLECTOR, NEGOTIATOR, SCHEDD, MASTER

## Performance tuning
UPDATE_INTERVAL = 60
STARTER_UPDATE_INTERVAL = 60
SHADOW_QUEUE_UPDATE_INTERVAL = 60

## File transfer
ENABLE_URL_TRANSFERS = TRUE
MAX_TRANSFER_INPUT_MB = 10240
MAX_TRANSFER_OUTPUT_MB = 10240

## Shared filesystem
UID_DOMAIN = {{ cluster_name }}.local
TRUST_UID_DOMAIN = TRUE
SOFT_UID_DOMAIN = TRUE

## Admin contact
CONDOR_ADMIN = admin@{{ cluster_name }}
