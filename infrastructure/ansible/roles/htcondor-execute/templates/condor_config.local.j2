## HTCondor Execute Node Configuration
## Generated by Ansible

## Role configuration
use ROLE: Execute

## Network configuration
CONDOR_HOST = {{ condor_host }}
NETWORK_INTERFACE = *
BIND_ALL_INTERFACES = TRUE

## Startd configuration
STARTD_NAME = {{ ansible_hostname }}

## Resource advertisement
NUM_CPUS = {{ ansible_processor_vcpus }}
MEMORY = {{ (ansible_memtotal_mb * 0.95) | int }}

## Docker Universe support
DOCKER = /usr/bin/docker
DOCKER_VOLUMES = /storage:/storage:rw

## Security - Pool Password
SEC_PASSWORD_FILE = /etc/condor/pool_password
SEC_DEFAULT_AUTHENTICATION = REQUIRED
SEC_DEFAULT_AUTHENTICATION_METHODS = PASSWORD
SEC_READ_AUTHENTICATION = REQUIRED
SEC_WRITE_AUTHENTICATION = REQUIRED
SEC_CLIENT_AUTHENTICATION = REQUIRED
SEC_ADVERTISE_STARTD_AUTHENTICATION = REQUIRED

## Authorization
ALLOW_READ = *
ALLOW_WRITE = condor@*
ALLOW_DAEMON = condor@*
ALLOW_ADMINISTRATOR = condor@$(CONDOR_HOST)

## High port range
HIGHPORT = 42000
LOWPORT = 41000

## Logging
MAX_DEFAULT_LOG = 100000000
MAX_NUM_DEFAULT_LOG = 5
TRUNC_DEFAULT_LOG_ON_OPEN = FALSE

## Daemon list (startd + master only)
DAEMON_LIST = STARTD, MASTER

## Job execution directory
EXECUTE = /var/lib/condor/execute

## Start policy - always accept jobs
START = TRUE
SUSPEND = FALSE
CONTINUE = TRUE
PREEMPT = FALSE
KILL = FALSE
WANT_SUSPEND = FALSE
WANT_VACATE = FALSE

## Claim work life
CLAIM_WORKLIFE = 3600

## Performance tuning
UPDATE_INTERVAL = 60
STARTER_UPDATE_INTERVAL = 60

## File transfer
ENABLE_URL_TRANSFERS = TRUE

## Shared filesystem
UID_DOMAIN = {{ cluster_name }}.local
TRUST_UID_DOMAIN = TRUE
SOFT_UID_DOMAIN = TRUE

## Admin contact
CONDOR_ADMIN = admin@{{ cluster_name }}
