# SLURM Configuration for NuDocker HUN-REN Cloud
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Cluster: {{ cluster_name }}

#======================================================================
# CONTROLLER CONFIGURATION
#======================================================================
ClusterName={{ cluster_name }}
SlurmctldHost={{ hostvars[groups['central_manager'][0]]['ansible_hostname'] }}({{ hostvars[groups['central_manager'][0]]['ansible_default_ipv4']['address'] }})
SlurmctldPort=6817
SlurmctldLogFile=/var/log/slurm/slurmctld.log
StateSaveLocation=/var/spool/slurmctld
SlurmctldPidFile=/var/run/slurm/slurmctld.pid

#======================================================================
# AUTHENTICATION & SECURITY
#======================================================================
AuthType=auth/munge
CryptoType=crypto/munge

#======================================================================
# SCHEDULING
#======================================================================
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory

# Scheduling parameters
SchedulerTimeSlice=30
DefMemPerCPU=2048
MaxMemPerCPU=8192

#======================================================================
# TIMEOUTS
#======================================================================
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0

#======================================================================
# LOGGING
#======================================================================
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd-%n.log
SlurmdPidFile=/var/run/slurm/slurmd.pid
SlurmdSpoolDir=/var/spool/slurmd

#======================================================================
# PROCESS TRACKING AND TASK MANAGEMENT
#======================================================================
ProctrackType=proctrack/linuxproc
TaskPlugin=task/affinity,task/cgroup
TaskPluginParam=Sched

#======================================================================
# CGROUP CONFIGURATION
#======================================================================
CgroupMountpoint=/sys/fs/cgroup

#======================================================================
# ACCOUNTING
#======================================================================
{% if slurm_accounting_enabled | default(false) %}
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ hostvars[groups['central_manager'][0]]['ansible_hostname'] }}
AccountingStoragePort=6819
AccountingStoreFlags=job_comment
JobAcctGatherType=jobacct_gather/linux
JobAcctGatherFrequency=30
{% else %}
AccountingStorageType=accounting_storage/none
JobAcctGatherType=jobacct_gather/none
{% endif %}

#======================================================================
# JOB COMPLETION
#======================================================================
JobCompType=jobcomp/none

#======================================================================
# RESOURCE LIMITS
#======================================================================
MaxJobCount=10000
MaxSubmitJobs=10000
MaxArraySize=10000

#======================================================================
# COMPUTE NODES
#======================================================================
{% for host in groups['execute_nodes'] %}
{% set node_num = loop.index %}
NodeName={{ hostvars[host]['ansible_hostname'] }} \
    NodeAddr={{ hostvars[host]['ansible_default_ipv4']['address'] }} \
    CPUs={{ hostvars[host]['ansible_processor_vcpus'] | default(8) }} \
    RealMemory={{ (hostvars[host]['ansible_memtotal_mb'] * 0.95) | int }} \
    TmpDisk={{ (hostvars[host]['ansible_mounts'][0]['size_total'] / 1024 / 1024 * 0.8) | int }} \
    State=UNKNOWN \
    Features=mesa,docker,singularity
{% endfor %}

#======================================================================
# PARTITIONS
#======================================================================
# Normal partition - default, max 7 days
PartitionName=normal \
    Nodes={{ groups['execute_nodes'] | map('extract', hostvars, 'ansible_hostname') | join(',') }} \
    Default=YES \
    MaxTime=7-00:00:00 \
    State=UP \
    Priority=1 \
    DefMemPerCPU=2048 \
    MaxMemPerCPU=8192

# Short partition - max 24 hours, higher priority
PartitionName=short \
    Nodes={{ groups['execute_nodes'] | map('extract', hostvars, 'ansible_hostname') | join(',') }} \
    Default=NO \
    MaxTime=1-00:00:00 \
    State=UP \
    Priority=5 \
    DefMemPerCPU=2048 \
    MaxMemPerCPU=8192

# Long partition - max 30 days for extensive calculations
PartitionName=long \
    Nodes={{ groups['execute_nodes'] | map('extract', hostvars, 'ansible_hostname') | join(',') }} \
    Default=NO \
    MaxTime=30-00:00:00 \
    State=UP \
    Priority=0 \
    DefMemPerCPU=2048 \
    MaxMemPerCPU=8192

#======================================================================
# PROPAGATE RESOURCE LIMITS
#======================================================================
PropagateResourceLimits=NONE
PropagateResourceLimitsExcept=MEMLOCK
